{
  "expo": {
    "name": "Collage Studio",
    "slug": "collage-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.collagestudio.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "instagram"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.collagestudio.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#0F0D16"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Collage Studio needs your photos to build collages.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Collage Studio saves finished collages to its own album.",
          "savePhotosPermission": "Collage Studio saves finished collages to its own album.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing"
    ],
    "backgroundColor": "#0F0D16"
  }
}
